{
  "name": "solstice",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "scenes",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc --build",
    "build:web": "npm run build --workspace @solstice/web",
    "scenes": "npm run build --workspace @solstice/scenes",
    "typecheck": "tsc --build",
    "typecheck:scenes": "tsc --noEmit -p scenes/tsconfig.json",
    "typecheck:tools": "tsc --noEmit -p packages/scene-tools/tsconfig.json && tsc --noEmit -p apps/cli/tsconfig.json",
    "pretest": "tsc --build",
    "test": "vitest run",
    "dev": "npm run dev --workspace @solstice/web",
    "api": "npm run dev --workspace @solstice/api",
    "solstice": "node apps/cli/src/solstice.ts",
    "lint:corpus": "bash corpus/lint.sh",
    "check": "npm run lint && npm run typecheck && npm run typecheck:web && npm run typecheck:scenes && npm run typecheck:tools && npm run typecheck:tests && npm run test && npm run scenes && npm run build:web && npm run lint:corpus",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "assets": "node assets/download-list.ts",
    "lint": "biome check .",
    "format:check": "prettier --check .",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.0.5"
  }
}
