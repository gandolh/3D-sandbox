{
  "name": "solstice",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "scenes",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc --build",
    "scenes": "npm run build --workspace @solstice/scenes",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "lint:corpus": "bash corpus/lint.sh",
    "check": "npm run build && npm run typecheck && npm run test && npm run scenes && npm run lint:corpus"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
