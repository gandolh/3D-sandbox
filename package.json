{
  "name": "solstice",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "scenes",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc --build",
    "build:web": "npm run build --workspace @solstice/web",
    "scenes": "npm run build --workspace @solstice/scenes",
    "typecheck": "tsc --build",
    "typecheck:scenes": "tsc --noEmit -p scenes/tsconfig.json",
    "test": "vitest run",
    "dev": "npm run dev --workspace @solstice/web",
    "api": "npm run dev --workspace @solstice/api",
    "lint:corpus": "bash corpus/lint.sh",
    "check": "npm run lint && npm run typecheck && npm run typecheck:web && npm run typecheck:scenes && npm run test && npm run scenes && npm run build:web && npm run lint:corpus",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "assets": "node assets/download-list.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
