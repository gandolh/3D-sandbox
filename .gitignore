node_modules/
dist/
*.tsbuildinfo

# Downloaded assets. The binaries are NOT committed: even stripped to the maps a
# renderer can use, 17 assets come to 135 MB, and the three trees the scenes name
# come to 1.5 GB more. What is committed is how to get them —
# assets-src/DOWNLOADS.md, download.sh and download-heavy.sh, all generated by
# `npm run assets` — so a fresh clone is one command from a working render.
#
# This is also why `asset-resolves` checks assets/verified.json when nothing is
# downloaded: on a clone that is the normal state, and the rule still has to bite.
assets-src/*/
!assets-src/DOWNLOADS.md
!assets-src/download.sh
!assets-src/download-heavy.sh

.DS_Store

# Derived index — disposable, rebuilt by rescanning scenes/
apps/api/.data/
