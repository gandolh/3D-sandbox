# Exact versions, always. A range means two clones of this repo can resolve
# different code, and "works on my machine" becomes structurally possible.
save-exact=true

# Fail rather than warn when Node is too old.
#
# The scripts are run by Node directly and depend on its native type stripping,
# so on Node 20 they die with a raw syntax error pointing at a type annotation —
# which names nothing useful and looks like a bug in the code. `engines` was
# already declared and npm was only warning about it.
engine-strict=true
