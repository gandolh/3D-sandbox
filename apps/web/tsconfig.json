{
  // Extends the base like every other workspace.
  //
  // It used to re-declare `strict`, `noUncheckedIndexedAccess`,
  // `exactOptionalPropertyTypes`, `noImplicitOverride`,
  // `noFallthroughCasesInSwitch`, `isolatedModules`, `verbatimModuleSyntax` and
  // `skipLibCheck` by hand. They matched, so nothing was wrong — but any flag
  // added to the base silently did not reach this workspace, which is the
  // largest in the repo and the one most likely to be open.
  //
  // Everything kept below is a genuine override: a browser bundle needs a
  // different module system, JSX, DOM libs and no emit, none of which suit a
  // Node package. That is what `extends` is for.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Vite resolves and bundles; `NodeNext` would demand extensions it does
    // not want and refuse the ones it does.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "vite.config.ts"]
}
